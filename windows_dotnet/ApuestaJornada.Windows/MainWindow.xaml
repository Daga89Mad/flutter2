<Window x:Class="ApuestaJornada.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Apuesta a jornada · Windows · 0.7.2" Width="850" Height="720" MinWidth="650" MinHeight="560" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="28">
  <TextBlock TextWrapping="Wrap" Text="Apuesta a jornada" FontSize="28" FontWeight="Bold" Foreground="#172239"/>
  <TextBlock TextWrapping="Wrap" Text="Conexión con tu móvil · C# / .NET" Foreground="#536078" Margin="0,4,0,18"/>
  <Border Background="#FFF1CE" CornerRadius="8" Padding="14" Margin="0,0,0,18">
   <TextBlock TextWrapping="Wrap" Text="Ronda REAL independiente: 1 → 2 → 4 → 8 → 16 → 32 → 64 → 128 €. Máximo por apuesta 128 €; acumulado 255 €. Se detiene tras un empate o cualquier ejecución sin conciliar." Foreground="#6D4A05"/>
  </Border>
  <Border Background="White" CornerRadius="10" Padding="20">
   <StackPanel>
    <TextBlock TextWrapping="Wrap" Text="Cuenta de nuestra app" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock TextWrapping="Wrap" Text="Usa el mismo correo y contraseña del móvil. Tus credenciales de Betfair se configuran en su propio programa." Foreground="#536078" Margin="0,6,0,14"/>
    <CheckBox x:Name="LiveMode" Content="REAL · Habilitar una orden de prueba de 1 € con OK REAL del móvil" Margin="0,4,0,12"/>
    <CheckBox x:Name="RoundMode" Checked="RoundModeChanged" Unchecked="RoundModeChanged" Content="REAL · Ronda de hasta 8 apuestas, máximo por apuesta 128 € y total 255 €" Margin="0,4,0,12" />
    <CheckBox x:Name="ReadOnlyMode" IsChecked="True" Content="Sólo comprobar historial · no publicar órdenes de ronda" Margin="0,4,0,12" />
    <TextBlock Text="Historial BF Bot · uk_bets_history.gz" />
    <TextBox x:Name="HistoryPath" Margin="0,4,0,12" Padding="8" />
    <CheckBox x:Name="AutoSaveVerified" Content="He comprobado que BF Bot guarda el historial al actualizar apuestas con el programa abierto" Margin="0,4,0,12" />
    <TextBlock TextWrapping="Wrap" Text="Archivo .gz de Empates por jornada (requerido en REAL)"/>
    <TextBox x:Name="StrategyPath" Margin="0,4,0,12" Padding="8"/>
    <TextBlock TextWrapping="Wrap" Text="Correo"/>
    <TextBox x:Name="Email" Margin="0,4,0,12" Padding="8"/>
    <TextBlock TextWrapping="Wrap" Text="Contraseña"/>
    <PasswordBox x:Name="Password" Margin="0,4,0,16" Padding="8"/>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="Connect" Content="Conectar PC" Click="Connect_Click" Background="#244EC5" Foreground="White"/>
     <Button x:Name="Stop" Content="Detener PC" Click="Stop_Click" IsEnabled="False"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <Border Background="White" CornerRadius="10" Padding="20" Margin="0,16,0,0">
   <StackPanel>
    <TextBlock TextWrapping="Wrap" Text="Estado de la conexión" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock TextWrapping="Wrap" x:Name="Status" Text="Inicia sesión y confirma la jornada en el móvil." Margin="0,10,0,8"/>
    <TextBlock TextWrapping="Wrap" x:Name="Round" Foreground="#536078"/>
    <TextBox x:Name="Outbox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,12"/>
    <TextBlock TextWrapping="Wrap" x:Name="LastSeen" Foreground="#536078" Margin="0,4,0,12"/>
    <ListView x:Name="History" Height="130">
     <ListView.View><GridView>
      <GridViewColumn Header="Partido" Width="370" DisplayMemberBinding="{Binding Match}"/>
      <GridViewColumn Header="Importe" Width="100" DisplayMemberBinding="{Binding Amount}"/>
      <GridViewColumn Header="Cuota / estado" Width="110" DisplayMemberBinding="{Binding Odds}"/>
     </GridView></ListView.View>
    </ListView>
   </StackPanel>
  </Border>
  <TextBlock TextWrapping="Wrap" Text="Puedes cerrar el móvil después de recibir la confirmación del PC. Windows debe permanecer encendido, conectado y sin suspensión. Para revocar el OK guardado, utiliza la app móvil." Foreground="#536078" Margin="0,16,0,0"/>
 </StackPanel>
 </ScrollViewer>
</Window>
