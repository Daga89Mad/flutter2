<Window x:Class="ApuestaJornada.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Apuesta a jornada · Windows · 0.3" Width="850" Height="720" MinWidth="650" MinHeight="560" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="28">
  <TextBlock Text="Apuesta a jornada" FontSize="28" FontWeight="Bold" Foreground="#172239"/>
  <TextBlock Text="Conexión con tu móvil · C# / .NET" Foreground="#536078" Margin="0,4,0,18"/>
  <Border Background="#FFF1CE" CornerRadius="8" Padding="14" Margin="0,0,0,18">
   <TextBlock Text="SIMULACIÓN · Este programa no envía dinero ni órdenes a Betfair o BF Bot Manager." Foreground="#6D4A05"/>
  </Border>
  <Border Background="White" CornerRadius="10" Padding="20">
   <StackPanel>
    <TextBlock Text="Cuenta de nuestra app" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="Usa el mismo correo y contraseña del móvil. Tus credenciales de Betfair se configuran en su propio programa." Foreground="#536078" Margin="0,6,0,14"/>
    <TextBlock Text="Correo"/>
    <TextBox x:Name="Email" Margin="0,4,0,12" Padding="8"/>
    <TextBlock Text="Contraseña"/>
    <PasswordBox x:Name="Password" Margin="0,4,0,16" Padding="8"/>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="Connect" Content="Conectar PC" Click="Connect_Click" Background="#244EC5" Foreground="White"/>
     <Button x:Name="Stop" Content="Detener PC" Click="Stop_Click" IsEnabled="False"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <Border Background="White" CornerRadius="10" Padding="20" Margin="0,16,0,0">
   <StackPanel>
    <TextBlock Text="Estado del ensayo" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock x:Name="Status" Text="Inicia sesión y confirma la jornada en el móvil." Margin="0,10,0,8"/>
    <TextBlock x:Name="Round" Foreground="#536078"/>
    <TextBlock x:Name="LastSeen" Foreground="#536078" Margin="0,4,0,12"/>
    <ListView x:Name="History" Height="130">
     <ListView.View><GridView>
      <GridViewColumn Header="Partido" Width="370" DisplayMemberBinding="{Binding Match}"/>
      <GridViewColumn Header="Ensayo" Width="100" DisplayMemberBinding="{Binding Amount}"/>
      <GridViewColumn Header="Cuota ficticia" Width="110" DisplayMemberBinding="{Binding Odds}"/>
     </GridView></ListView.View>
    </ListView>
   </StackPanel>
  </Border>
  <TextBlock Text="Puedes cerrar el móvil después de recibir la confirmación del PC. Windows debe permanecer encendido, conectado y sin suspensión. Para revocar el OK guardado, utiliza la app móvil." Foreground="#536078" Margin="0,16,0,0"/>
 </StackPanel>
 </ScrollViewer>
</Window>
